# realtime-speech — 環境変数サンプル（プレースホルダーのみ。実値はリポジトリルートの .env に置く。.gitignore 済み）
# スクリプトは引数を省略したときにこれらを参照する。実 GUID・シークレット・固有名は書かない。

# === Speech リソース（get_speech_token.ps1）===
# 取得元: az cognitiveservices account list --query "[?kind=='SpeechServices']"
SPEECH_RESOURCE_GROUP=<RESOURCE_GROUP>
SPEECH_ACCOUNT_NAME=<SPEECH_ACCOUNT_NAME>       # カスタム サブドメイン必須
SPEECH_REGION=<REGION>                          # 例: japaneast（CSP の wss://<region>.stt.speech.microsoft.com と一致させる）

# === 検証スクリプト（verify_*.mjs）===
# SPEECH_TOKEN は .env に保存しない。get_speech_token.ps1 -Raw の出力をシェル変数で渡す

# === トークン発行コネクタ（deploy_token_connector.py）===
ENV_ID=<POWER_PLATFORM_ENVIRONMENT_ID>          # 取得元: pac org who
TENANT_ID=<TENANT_ID>
SOLUTION_NAME=<SOLUTION_UNIQUE_NAME>
