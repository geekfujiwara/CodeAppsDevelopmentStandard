# Existing approved environment and solution; read by standard/auth_helper.py.
DATAVERSE_URL=https://<org>.crm.dynamics.com
TENANT_ID={tenant-id}
SOLUTION_NAME={existing-solution-name}
PUBLISHER_PREFIX={existing-publisher-prefix}

# Logical names from approved Dataverse metadata, not entity-set plurals.
PLANT_DESIGN_TABLE={prefix}_plantdesign
PLANT_REVISION_TABLE={prefix}_plantrevision
PLANT_PROPOSAL_TABLE={prefix}_plantproposal
PLANT_DESIGN_LOOKUP={prefix}_designid
PLANT_REVISION_COLUMN={prefix}_revision

# Existing bot and schema, from Dataverse. Never run create_agent.py to update it.
AGENT_BOTID={existing-bot-id}
AGENT_SCHEMA={existing-bot-schema}
SKILL_NAME=plant-design
SKILL_DIR={project-local-flat-agent-skill-directory}