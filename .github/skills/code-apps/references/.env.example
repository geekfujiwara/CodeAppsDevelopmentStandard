# Code Apps スキルのスクリプトが参照するパラメータ
# 実値はリポジトリルートの .env に置く（.gitignore 済み）。このファイルには値を書かない。

# Dataverse 組織 URL（Power Platform 管理センター > 環境 > 環境 URL）
DATAVERSE_URL=https://<org>.crm.dynamics.com

# テナント ID（`pac auth list` / Entra 管理センターの概要）
TENANT_ID=00000000-0000-0000-0000-000000000000

# 環境 ID（Power Platform 管理センター > 環境 > 環境 ID）
# scripts/pre-deploy-check.mjs は ENV_ID を必須キーとして見るため、両方を同じ値で置く。
ENVIRONMENT_ID=00000000-0000-0000-0000-000000000000
ENV_ID=00000000-0000-0000-0000-000000000000

# 対象ソリューションの一意名（`pac solution list` の SolutionUniqueName）
SOLUTION_NAME=YourSolutionUniqueName

# 対象ソリューションの ID（`npx pa app push --solution-id` に渡す GUID）
SOLUTION_ID=00000000-0000-0000-0000-000000000000

# 発行者プレフィックス（`pac solution list` の PublisherUniqueName に紐づくプレフィックス）
PUBLISHER_PREFIX=your

# Dataverse 接続 ID（`pac connection list` / `npx pa connection list`）
# setup_connection_reference.py が接続参照を新規作成する際にバインドする
DATAVERSE_CONNECTION_ID=

# Code App の App ID（`pac code list` / power.config.json の appId）
APP_ID=00000000-0000-0000-0000-000000000000

# Code App 共有先（メールアドレスまたは Entra object ID をカンマ区切りで指定）
# 通常利用者／実行主体は play。edit は共同開発者など必要な主体だけを別管理する。
CODE_APP_PLAY_PRINCIPALS=user@contoso.com,{USER_OBJECT_ID},{SERVICE_PRINCIPAL_OBJECT_ID}
CODE_APP_EDIT_PRINCIPALS={DEVELOPER_USER_OBJECT_ID}

# Power Apps CLI のクラウド。通常テナントは public
POWER_APPS_CLOUD=public

# ── templates/agm-qa-assist（株主総会 Q&A アシスト）──────────────
# scaffold 時に AskUserQuestion で聞く（scaffold.json の questions）。取得元は各質問の detect を参照
# VITE_CODEAPPS_APP_NAME=株主総会 Q&A アシスト
# VITE_CODEAPPS_DOCUMENT_TITLE=株主総会 Q&A アシスト      # VITE_CODEAPPS_APP_NAME と同じ（sameAs）
# VITE_AGM_MEETING_TITLE=第43期 定時株主総会
# VITE_AGM_MEETING_DATE=2027-06-25
# VITE_DATAVERSE_URL=https://<org>.crm.dynamics.com/      # DATAVERSE_URL と同じ（sameAs）

# Construction Cockpit scaffold only
# New UUID for the Microsoft 365 app package manifest
COWORK_PLUGIN_ID=
# Dataverse origin without a trailing slash, for example https://<org>.crm.dynamics.com
DATAVERSE_ORIGIN=https://<org>.crm.dynamics.com/      # DATAVERSE_URL と同じ（sameAs）
# VITE_PUBLISHER_PREFIX=<prefix>                         # PUBLISHER_PREFIX と同じ（sameAs）
# SOLUTION_DISPLAY_NAME=株主総会 Q&A アシスト
# VITE_AGM_SP_SITE_URL=https://<tenant>.sharepoint.com/sites/<site>
# VITE_AGM_SP_LIBRARY=AGMRecordings
# AZURE_SUBSCRIPTION_ID=<az account show --query id>
# AZURE_RESOURCE_GROUP=rg-agm-qa
# AZURE_LOCATION=japaneast
# SPEECH_RESOURCE_NAME=<世界で一意>
# AOAI_RESOURCE_NAME=<世界で一意>
# AOAI_DEPLOYMENT=gpt-5.4-mini
# AOAI_MODEL_VERSION=<az cognitiveservices model list で確認。新規デプロイ時だけ>
# 設定画面で選べるデプロイ（カンマ区切り。デプロイ済みのものだけ）
# AOAI_DEPLOYMENTS=gpt-5.4-mini,gpt-4.1-mini
# MAI-Transcribe の Foundry リソース（任意。日本のリージョンは未提供 → southeastasia 等。空なら使わない）
# MAI_SPEECH_RESOURCE_NAME=<世界で一意>
# MAI_LOCATION=southeastasia
# FUNCTION_APP_NAME=<世界で一意>
# API_AUDIENCE=api://<app-id>                            # mcp-server の configure_entra_api.py が作る
# OPERATOR_UPN=<オペレーターの UPN>
# VIEWER_UPN=<閲覧する幹部の UPN>

# ── templates/store-ordering（店舗発注システム） ──
# テーブルの名前空間（<接頭辞>_tk。例: contoso_tk）
VITE_TABLE_PREFIX=
# 同じ接頭辞のパブリッシャーが複数あるときに使うパブリッシャーの一意の名前（Dataverse の publishers.uniquename）
PUBLISHER_UNIQUE_NAME=
# 最初に入れるデモのシナリオ（templates/store-ordering/demo-data/scenarios/*.json の名前）
SCENARIO=demo-1030-rain
