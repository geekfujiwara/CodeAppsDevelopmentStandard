# Code Apps スキルのスクリプトが参照するパラメータ
# 実値はリポジトリルートの .env に置く（.gitignore 済み）。このファイルには値を書かない。

# Dataverse 組織 URL（Power Platform 管理センター > 環境 > 環境 URL）
DATAVERSE_URL=https://<org>.crm.dynamics.com

# テナント ID（`pac auth list` / Entra 管理センターの概要）
TENANT_ID=00000000-0000-0000-0000-000000000000

# 環境 ID（Power Platform 管理センター > 環境 > 環境 ID）
ENVIRONMENT_ID=00000000-0000-0000-0000-000000000000

# 対象ソリューションの一意名（`pac solution list` の SolutionUniqueName）
SOLUTION_NAME=YourSolutionUniqueName

# 発行者プレフィックス（`pac solution list` の PublisherUniqueName に紐づくプレフィックス）
PUBLISHER_PREFIX=your

# Dataverse 接続 ID（`pac connection list` / `npx power-apps list-connections`）
# setup_connection_reference.py が接続参照を新規作成する際にバインドする
DATAVERSE_CONNECTION_ID=

# Code App の App ID（`pac code list` / power.config.json の appId）
APP_ID=00000000-0000-0000-0000-000000000000
