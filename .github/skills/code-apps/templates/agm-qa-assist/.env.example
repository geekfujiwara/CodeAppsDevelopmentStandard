# ==========================================================
# Code Apps 汎用ベーステンプレート — カスタマイズガイド
# ==========================================================
# このファイルをプロジェクトルートの .env にコピーして値を入力してください。
# 共通 .env.example（.github/skills/standard/references/.env.example）に記載の
# 共通変数（DATAVERSE_URL / TENANT_ID 等）も別途必要です。
# ==========================================================

# ── Dataverse（必須） ──────────────────────────────────────
# テーブル論理名の接頭辞。テーブル名をコードにハードコードしないために使う
VITE_PUBLISHER_PREFIX=

# テーブル論理名の名前空間。1 ソリューションに複数業務を同居させる場合に使う
# 例: VITE_PUBLISHER_PREFIX=contoso / VITE_TABLE_PREFIX=contoso_kb
# 省略時は VITE_PUBLISHER_PREFIX + "_" を使う
VITE_TABLE_PREFIX=

# 生成された *WithOrganization 系メソッドへ渡す組織 URL（末尾スラッシュ付き）
# 例: https://{org}.crm.dynamics.com/
# 省略すると Invalid organization URL 'null' provided で失敗する
VITE_DATAVERSE_URL=

# ── アプリ表示（変更推奨） ──────────────────────────────────
VITE_CODEAPPS_APP_NAME=Code App
VITE_CODEAPPS_APP_SUBTITLE=
VITE_CODEAPPS_DOCUMENT_TITLE=Code App
VITE_CODEAPPS_THEME_STORAGE_KEY=code-app-theme
# ナビゲーション構成は src/config.ts に直接記述（env var では管理しない）

# ── 機能フラグ ──────────────────────────────────────────────
# 業務ページを追加したら VITE_FEATURE_XXX を足し、src/config.ts の
# conditionalItems で出し分ける

# ── 株主総会 Q&A アシスト ──
# 総会レコード（Dataverse）の名前と開催日。同じ名前の総会レコードを使い回す
VITE_AGM_MEETING_TITLE=
VITE_AGM_MEETING_DATE=
# 録音の保存先（SharePoint サイト URL とドキュメント ライブラリの URL 名）
VITE_AGM_SP_SITE_URL=https://{tenant}.sharepoint.com/sites/{site}
VITE_AGM_SP_LIBRARY=

# ── 接続参照（論理名。setup_connection_reference.py / create_connection.py で作ったもの）──
CONNECTION_REFERENCE_LOGICAL_NAME=
AGM_SPEECH_CONNREF=
AGM_SHAREPOINT_CONNREF=

# ── Azure（scripts/configure_azure.py が使う）──────────────────
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=japaneast
SPEECH_RESOURCE_NAME=
AOAI_RESOURCE_NAME=
# 生成・株主照合のモデル（DataZoneStandard / APAC で検証済み）
AOAI_DEPLOYMENT=gpt-5.4-mini
AOAI_MODEL_VERSION=
AOAI_SKU=DataZoneStandard
AOAI_CAPACITY=100
FUNCTION_APP_NAME=
# configure_entra_api.py が作る API（api://<app-id>）と公開スコープ
API_AUDIENCE=
API_SCOPE=Speech.Token

# ── ロールの割り当て（setup_security_roles.py --assign-operator / --assign-viewer に渡す UPN）──
OPERATOR_UPN=
VIEWER_UPN=
# MAI-Transcribe（任意。日本のリージョンでは未提供。東南アジア等に Foundry リソースを作る。先頭のモデルが画面の既定）
MAI_SPEECH_RESOURCE_NAME=
MAI_LOCATION=southeastasia
MAI_MODELS=MAI-Transcribe-2,MAI-Transcribe-1.5

# ── CSP（predeploy チェック 13）──
# configure_code_app_csp.py で connect-src を追加して fetch / WebSocket を使うテンプレートのため、
# 既定 CSP 向けの事前検出から connect-src を外す
CODE_APP_CSP_ALLOW=connect-src
