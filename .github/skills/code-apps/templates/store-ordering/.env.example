# ==========================================================
# Code Apps 汎用ベーステンプレート — カスタマイズガイド
# ==========================================================
# このファイルをプロジェクトルートの .env にコピーして値を入力してください。
# 共通 .env.example（.github/skills/standard/references/.env.example）に記載の
# 共通変数（DATAVERSE_URL / TENANT_ID 等）も別途必要です。
# ==========================================================

# ── Dataverse（必須） ──────────────────────────────────────
# テーブル論理名の接頭辞。テーブル名をコードにハードコードしないために使う
VITE_PUBLISHER_PREFIX=

# テーブル論理名の名前空間。1 ソリューションに複数業務を同居させる場合に使う
# 例: VITE_PUBLISHER_PREFIX=contoso / VITE_TABLE_PREFIX=contoso_kb
# 省略時は VITE_PUBLISHER_PREFIX + "_" を使う
VITE_TABLE_PREFIX=

# 生成された *WithOrganization 系メソッドへ渡す組織 URL（末尾スラッシュ付き）
# 例: https://{org}.crm.dynamics.com/
# 省略すると Invalid organization URL 'null' provided で失敗する
VITE_DATAVERSE_URL=

# ── アプリ表示（変更推奨） ──────────────────────────────────
VITE_CODEAPPS_APP_NAME=店舗発注システム
VITE_CODEAPPS_APP_SUBTITLE=
VITE_CODEAPPS_DOCUMENT_TITLE=店舗発注システム
VITE_CODEAPPS_THEME_STORAGE_KEY=store-ordering-theme
# ナビゲーション構成は src/config.ts に直接記述（env var では管理しない）

# ── 機能フラグ ──────────────────────────────────────────────
# 業務ページを追加したら VITE_FEATURE_XXX を足し、src/config.ts の
# conditionalItems で出し分ける

# ── 店舗発注システム ──
# テーブルの名前空間は <接頭辞>_tk（例: contoso_tk → contoso_tkitem）
# VITE_TABLE_PREFIX=<接頭辞>_tk

# ── 共通（Dataverse の構築・デモデータ・接続参照） ──
DATAVERSE_URL=https://{org}.crm.dynamics.com/
TENANT_ID=
ENV_ID=
SOLUTION_NAME=
SOLUTION_DISPLAY_NAME=
PUBLISHER_PREFIX=
# 既存のパブリッシャーを使う（同じ接頭辞のパブリッシャーが複数あるときは必須）
PUBLISHER_UNIQUE_NAME=
# デモデータの行 ID の名前空間（GUID）。空なら既定値。一度投入した環境では変えない
DEMO_ID_NAMESPACE=
# デモデータのシナリオ（demo-data/scenarios/*.json の名前）
SCENARIO=demo-1030-rain
# setup_connection_reference.py --write-env が書き込む
SOLUTION_ID=
CONNECTION_REFERENCE_LOGICAL_NAME=
