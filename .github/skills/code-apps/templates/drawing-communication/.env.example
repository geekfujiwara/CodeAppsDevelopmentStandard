# ==========================================================
# Drawing Communication Addon — 組み込み先プロジェクトへ追記する変数
# ==========================================================
# このアドオン自体は環境変数なしで動きます（既定は DEMO ワーカー）。
# 組み込み先の .env に必要な分だけ追記してください。
# 共通変数（DATAVERSE_URL / TENANT_ID / ENV_ID 等）は
# .github/skills/standard/references/.env.example を参照。
# VITE_ 変数はビルド成果物に平文で入ります。秘密値を入れないでください。
# ==========================================================

# ── 会話ワーカー ────────────────────────────────────────────
# false: DEMO ワーカー（ローカル寸法規則。AI 応答ではない）
# true : Dataverse の要求 / 結果テーブルへ接続したトランスポートを使う
VITE_FEATURE_DRAWING_CONVERSATION=false

# 要求 / 結果テーブルの論理名（VITE_FEATURE_DRAWING_CONVERSATION=true のとき必須）
# 取得元: Power Apps > テーブル > 詳細 > 論理名
VITE_DRAWING_REQUEST_TABLE=
VITE_DRAWING_RESULT_TABLE=

# 結果のポーリング間隔（ミリ秒）と打ち切り時間（ミリ秒）
VITE_DRAWING_POLL_INTERVAL_MS=1500
VITE_DRAWING_POLL_TIMEOUT_MS=120000

# ── 図面の保存先 ────────────────────────────────────────────
# false: ブラウザの localStorage のみ（PoC 既定）
# true : Dataverse の図面 / 改訂テーブルへ保存するアダプターを使う
VITE_FEATURE_DRAWING_STORAGE=false
VITE_DRAWING_TABLE=
VITE_DRAWING_REVISION_TABLE=
