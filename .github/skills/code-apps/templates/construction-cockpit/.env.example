# Dataverse schema. scaffold 時の PUBLISHER_PREFIX と同じ値を使う
SOLUTION_NAME=ConstructionCockpit
PUBLISHER_PREFIX=
VITE_PUBLISHER_PREFIX=
VITE_DATAVERSE_URL=

# App display
VITE_CODEAPPS_APP_NAME=現場コックピット
VITE_CODEAPPS_APP_SUBTITLE=Project Orbit
VITE_CODEAPPS_DOCUMENT_TITLE=現場コックピット
VITE_CODEAPPS_THEME_STORAGE_KEY=construction-cockpit-theme

# Environment and ALM
ENV_ID=
DATAVERSE_URL=
SOLUTION_ID=
CONNECTION_REFERENCE_LOGICAL_NAME=

# Cowork publication. Never commit the populated .env
COWORK_OAUTH_CLIENT_ID=
COWORK_OAUTH_CLIENT_SECRET=
COWORK_OAUTH_REGISTRATION_ID=

# KY の AI 危険予測（Copilot Studio の Workflow 経由）。off にすると過去事例の検索だけで表示する（クレジットを使わない）
VITE_KY_AI=agent
