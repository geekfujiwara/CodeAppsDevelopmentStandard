# ==========================================================
# sales-crm テンプレート — 環境設定
# ==========================================================
# このファイルを .env にコピーして値を入力する（.env はコミットしない）。

# ── 共通（必須）: Power Apps ポータル > 設定 > セッション詳細 ──
DATAVERSE_URL=https://{org}.crm.dynamics.com/
TENANT_ID={tenant-id}
ENV_ID={environment-id}
SOLUTION_NAME={SolutionUniqueName}
PUBLISHER_PREFIX={prefix}
# setup_connection_reference.py --write-env .env が書き込む
SOLUTION_ID=
CONNECTION_REFERENCE_LOGICAL_NAME=

# ── アプリ（ビルド時に埋め込まれる） ──────────────────────────
# テーブル論理名の接頭辞。PUBLISHER_PREFIX と同じ値にする
VITE_PUBLISHER_PREFIX={prefix}
# 省略時は getContext().app.dataverseOrgUrl を使う
VITE_DATAVERSE_URL=
VITE_CODEAPPS_APP_NAME=Sales Command Center
VITE_CODEAPPS_APP_SUBTITLE=目標達成を、チームで。
VITE_CODEAPPS_DOCUMENT_TITLE=Sales Command Center
VITE_CODEAPPS_THEME_STORAGE_KEY=sales-crm-theme
# 金額表示の通貨（ISO 4217）とロケール
VITE_CRM_CURRENCY=JPY
VITE_CRM_LOCALE=ja-JP
# この日数以上、活動が記録されていない進行中の商談を「停滞」とみなす
VITE_CRM_STALL_DAYS=14

# ── 朝の営業ダイジェスト（scripts/deploy_manager_digest_flow.py） ──
# 配信先（; 区切り。省略時は実行ユーザー）
CRM_DIGEST_TO=
CRM_DIGEST_HOUR=8
# Windows のタイムゾーン ID
CRM_DIGEST_TIMEZONE=Tokyo Standard Time
# メール末尾に載せるアプリの URL（npm run deploy の出力。任意）
CRM_APP_URL=
