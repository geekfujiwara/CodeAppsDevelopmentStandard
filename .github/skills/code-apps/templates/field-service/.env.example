# ── 接続先（Power Platform 管理センター > 環境、Entra > 概要） ──
DATAVERSE_URL=https://{org}.crm.dynamics.com
TENANT_ID={your-tenant-id}
ENV_ID={your-environment-id}

# ── ソリューション（既存ソリューションと発行者から取得） ──
SOLUTION_NAME={your-solution-unique-name}
SOLUTION_DISPLAY_NAME=Field Service
SOLUTION_ID={your-solution-id}
PUBLISHER_PREFIX=${PUBLISHER_PREFIX}

# ── アプリ表示（ビルド時に取り込む公開設定。秘密値は置かない） ──
VITE_PUBLISHER_PREFIX=${PUBLISHER_PREFIX}
VITE_CODEAPPS_APP_NAME=フィールドサービス管理
VITE_CODEAPPS_APP_SUBTITLE=保守サービス統合基盤
VITE_CODEAPPS_DOCUMENT_TITLE=フィールドサービス管理
VITE_CODEAPPS_THEME_STORAGE_KEY=field-service-theme

# ── 任意機能（Google Maps: 住所が Google に送信されるため既定 OFF） ──
# 有効化前に configure_code_app_csp.py --directive Frame-Src --source https://www.google.com
# を承認付きで実行。predeploy は --assert で実際の許可状態を確認する。
VITE_FEATURE_MAPS=false

# ── 認証（setup_code_app_auth.py が承認済み設定を保存。秘密値ではない） ──
PP_AUTH_MODE=browser
PP_AUTH_ACCOUNT=
PP_AUTH_EDGE_PROFILE=
PP_AUTH_ALLOW_INTERACTIVE=false

# ── 追加リソース（取得元: 接続参照セットアップ、コード アプリの共有先） ──
CONNECTION_REFERENCE_LOGICAL_NAME=
DATAVERSE_CONNECTION_ID=
CODE_APP_PLAY_PRINCIPALS=
