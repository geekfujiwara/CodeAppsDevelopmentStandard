# ==========================================================
# パース3D内見スタジオ（Perse3D Studio）
# ==========================================================
# このファイルをプロジェクトルートの .env にコピーして値を入力する（.env はコミットしない）。
# 認証・共通の値は standard スキルの references/.env.example も参照。

# ── 環境・ALM（必須。predeploy が検査する） ─────────────────
# 取得元: Power Platform 管理センター > 環境 > 環境 ID
ENV_ID=
# 取得元: Power Platform 管理センター > 環境 > 環境 URL（https://<org>.crm.dynamics.com）
DATAVERSE_URL=
# 取得元: Entra ID > 概要 > テナント ID
TENANT_ID=
# Dataverse のソリューション（無ければ setup_dataverse.py が作る）
SOLUTION_NAME=Perse3DStudio
SOLUTION_DISPLAY_NAME=パース3D内見スタジオ
# パブリッシャーの接頭辞。scaffold 時の PUBLISHER_PREFIX と同じ値（テーブルは <接頭辞>_perseproject / <接頭辞>_persecomment）
PUBLISHER_PREFIX=${PUBLISHER_PREFIX}
# 任意: 既存のパブリッシャーを一意名で指定する（未指定なら接頭辞で探す）
PUBLISHER_UNIQUE_NAME=
# setup_connection_reference.py --write-env .env が書き込む
SOLUTION_ID=
CONNECTION_REFERENCE_LOGICAL_NAME=

# ── アプリ（ビルド時に埋め込む） ────────────────────────────
VITE_PUBLISHER_PREFIX=${PUBLISHER_PREFIX}
# 省略時は VITE_PUBLISHER_PREFIX + "_"
VITE_TABLE_PREFIX=
# 生成された *WithOrganization 系メソッドへ渡す組織 URL（末尾スラッシュ付き。例: https://<org>.crm.dynamics.com/）
VITE_DATAVERSE_URL=
VITE_CODEAPPS_APP_NAME=パース3D内見スタジオ
VITE_CODEAPPS_APP_SUBTITLE=2D パース・間取り図から 3D 化して内見提案
VITE_CODEAPPS_DOCUMENT_TITLE=パース3D内見スタジオ
VITE_CODEAPPS_THEME_STORAGE_KEY=perse3d-theme

# ── データ保存先 ──────────────────────────────────────────────
# dataverse: Power Apps 上で Dataverse に保存（Dataverse のデータソースを追加していないと predeploy が止める）
# 未設定 / demo: ブラウザ保存（DEMO 表示）。ローカル開発（iframe 外）は常に DEMO
VITE_DATA_MODE=dataverse

# ── 物件ページ取得コネクタの動作確認（任意） ─────────────────
# setup_listing_connector.py が作成後に 1 回呼んで確かめる物件概要のパス（/<種類>/<都道府県>/<市区町村>/nc_<番号>/bukkengaiyo/）
LISTING_TEST_PATH=
