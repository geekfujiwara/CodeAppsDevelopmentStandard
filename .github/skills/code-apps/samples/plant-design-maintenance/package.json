{
  "name": "plant-design-maintenance-sample",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "generate": "node scripts/generate-plant-design.mjs && node scripts/generate-plant-sample.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run typecheck && vite build",
    "check:sample": "node scripts/check-sample.mjs",
    "predeploy": "npm run check:sample && npm test && npm run build"
  },
  "dependencies": {
