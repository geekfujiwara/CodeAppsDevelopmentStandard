# Public display settings; never put secrets in VITE_ variables.
VITE_CODEAPPS_APP_NAME=Plant Design & Maintenance
VITE_CODEAPPS_DOCUMENT_TITLE=Plant Design & Maintenance
# Obtain from the solution publisher and Dataverse environment settings.
VITE_PUBLISHER_PREFIX=
VITE_TABLE_PREFIX=
VITE_DATAVERSE_URL=
# Enable only after replacing integrations/connectors.ts and passing user authorization tests.
VITE_FEATURE_LIVE=false
VITE_FEATURE_RETRIEVAL=false
VITE_PLANT_CONVERSATION_ENABLED=false
VITE_PLANT_KNOWLEDGE_CONVERSATION_ENABLED=false
# Obtain from the authenticated pilot user's Entra object ID; server enforcement is also required.
VITE_PLANT_CONVERSATION_ALLOWED_OBJECT_ID=
# Obtain from the deployed Copilot Studio bot's schema and environment.
VITE_PLANT_AGENT_SCHEMA=
VITE_PLANT_DESIGN_COPILOT_ENVIRONMENT=
VITE_PLANT_DESIGN_COPILOT_SCHEMA=
# Obtain from the published AI Builder model; optional.
VITE_PLANT_MAINTENANCE_PROMPT_ID=