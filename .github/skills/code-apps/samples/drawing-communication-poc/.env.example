# ==========================================================
# drawing-communication-poc（図面コミュニケーション）— カスタマイズガイド
# ==========================================================
# このファイルをプロジェクトルートの .env にコピーして値を入力してください。
# 共通 .env.example（.github/skills/standard/references/.env.example）に記載の
# 共通変数（DATAVERSE_URL / TENANT_ID / ENV_ID / SOLUTION_NAME / PUBLISHER_PREFIX 等）も別途必要です。
# VITE_ 変数はビルド成果物に平文で含まれます。秘密値を入れないでください。
# ==========================================================

# ── アプリ表示（変更推奨） ──────────────────────────────────
VITE_CODEAPPS_APP_NAME=図面コミュニケーション
VITE_CODEAPPS_APP_SUBTITLE=設計レビュー ワークベンチ（PoC）
VITE_CODEAPPS_DOCUMENT_TITLE=図面コミュニケーション
VITE_CODEAPPS_THEME_STORAGE_KEY=drawing-poc-theme
# ナビゲーション構成は src/config.ts に直接記述（env var では管理しない）

# ── ローカル保存（任意） ────────────────────────────────────
# 下書きと使い方ガイドの表示状態を覚える localStorage のキー
VITE_DRAWING_STORAGE_KEY=drawing-communication-poc-draft
VITE_GUIDE_STORAGE_KEY=drawing-communication-poc-guide-seen

# ── 機能フラグ ──────────────────────────────────────────────
# false のあいだは Dataverse に接続せず、DEMO ワーカー（ローカル寸法規則）が応答します。
# AI エージェントの応答ではないことを UI にも表示します。
VITE_FEATURE_DRAWING_CONVERSATION=false
# false のあいだは改訂を localStorage にだけ残します（共有保存ではありません）。
VITE_FEATURE_DRAWING_STORAGE=false

# ── Dataverse（フラグを true にする場合に必須） ──────────────
# 取得元: Power Platform 管理センター > 環境 > 詳細（PUBLISHER_PREFIX と同値）
VITE_PUBLISHER_PREFIX=
# 取得元: Power Apps > テーブル > 詳細 > 論理名
VITE_DRAWING_TABLE=
VITE_DRAWING_REVISION_TABLE=
VITE_DRAWING_REQUEST_TABLE=
VITE_DRAWING_RESULT_TABLE=
# 取得元: 環境の組織 URL（末尾スラッシュ付き）例: https://{org}.crm.dynamics.com/
VITE_DATAVERSE_URL=

# ── 非同期待機の調整（任意） ────────────────────────────────
VITE_DRAWING_POLL_INTERVAL_MS=900
VITE_DRAWING_POLL_TIMEOUT_MS=120000
