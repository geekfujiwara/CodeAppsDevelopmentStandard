# data-migration — 環境変数サンプル
# 実値はリポジトリルートの .env に置く（.gitignore 済み）。
# 投入先の接続情報は data-platform / dataverse スキルと共通の変数を使う。

# === Dataverse（target.kind = dataverse）===
# 取得元: Power Platform 管理センター > 環境 > 環境 URL
DATAVERSE_URL=https://{org}.crm.dynamics.com

# === Azure Databricks（target.kind = databricks）===
# data-platform の deploy_platform.py apply 出力から転記（https:// は付けない）
DATABRICKS_HOST=adb-0000000000000000.0.azuredatabricks.net
DATABRICKS_WAREHOUSE_ID={warehouse-id}

# === Microsoft Fabric Lakehouse（target.kind = fabric-lakehouse）===
# workspaceId / lakehouseId は mapping.json の target に書く（build_mapping.py の引数で渡す）
