# custom-connector — 環境変数サンプル（プレースホルダーのみ。実値はリポジトリルートの .env に置く。.gitignore 済み）
# スクリプトは引数を省略したときにこれらを参照する。実 GUID・シークレット・固有名は書かない。

# === Power Platform（deploy_connector.py / create_connection.py）===
ENV_ID=<POWER_PLATFORM_ENVIRONMENT_ID>           # 取得元: pac org who（Environment ID）
DATAVERSE_URL=https://<org>.crm.dynamics.com/    # 取得元: pac org who（Org URL）。コネクタ ID と接続参照の解決に使う
TENANT_ID=<TENANT_ID>
SOLUTION_NAME=<SOLUTION_UNIQUE_NAME>             # コネクタと接続参照を入れるソリューション

# === Entra ID（mcp-server の configure_entra_api.py / configure_connector_oauth.py）===
MCP_API_APP_ID=<API_APP_ID>                      # API アプリのアプリケーション ID
MCP_API_SCOPE_VALUE=<SCOPE>                      # 例: Api.Access
MCP_API_SCOPE_LABEL=<同意画面に出す名前>          # 例: 「経費 API へのアクセス」。省略すると MCP 用の文言になる
MCP_API_SCOPE_DESCRIPTION=<同意画面の説明>

# OAuth のクライアント シークレットは .secrets/<name>.json（configure_connector_oauth.py が出力）。.env には書かない
