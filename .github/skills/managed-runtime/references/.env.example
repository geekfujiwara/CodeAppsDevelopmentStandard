# managed-runtime — 環境変数サンプル
# このファイルはプレースホルダーのみ。実値はリポジトリルートの .env に置く（.gitignore 済み）。
# scripts/*.py と templates/ は引数未指定時にここのキーを参照する。

# === CLI の固定版（check_prereqs.py）===
# 取得元: npm view @microsoft/managed-apps-cli version
# Preview 中は版を固定し、更新はリリース内容を確認してから行う
MANAGED_APPS_CLI_VERSION=<x.y.z>

# === アプリ作成（create_app.py）===
# 表示名（Managed Runtime ポータルに表示される名前）
MANAGED_APP_DISPLAY_NAME=<アプリの表示名>
# 作成先フォルダー（存在しないか空であること。既存アプリの中は不可）
MANAGED_APP_DIR=./<app-folder>
# リポジトリ方式: platform / github / none（作成後は変更できない）
MANAGED_APP_REPO_MODE=platform
# github のときだけ: 既存の空の private リポジトリ（github.com または *.ghe.com）
MANAGED_APP_REPO_URL=https://github.com/<org>/<repo>
# 空なら開発者環境へ自動ルーティング。特定環境に作る場合だけ指定（取得元: ms app info / 管理者）
MANAGED_APP_ENVIRONMENT_ID=

# === CI テンプレート（templates/github-actions-deploy）===
# リポジトリ ルートからのアプリのパス（ルート直下なら .）
MANAGED_APP_WORKDIR=.
# microsoft/Managed-Apps の Actions の参照。再現性のため不変タグ（v1.x.y）に固定する
# 取得元: https://github.com/microsoft/managed-apps/releases
MANAGED_APPS_ACTIONS_REF=<v1.x.y>
