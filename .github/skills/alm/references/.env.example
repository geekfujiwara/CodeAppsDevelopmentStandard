# ============================================================
# ALM（秘匿化・CI/CD）で使う環境変数のサンプル
# 実値は .env にのみ書き、.env は絶対にコミットしない。
# プロダクト固有の変数は各スキルの .env.example を参照して追記する。
# ============================================================

# --- 実装ルートと CI のルーティング（非秘匿） ---------------
# poc | production
IMPLEMENTATION_MODE=poc
# github | azure-devops | other
GIT_PROVIDER=github
# github | azure-devops | keyvault | none
SECRET_BACKEND=none

# --- CI の Azure ログイン（OIDC / ワークロード ID 用） -------
# クライアントシークレットは保管しない。フェデレーション資格情報を使う。
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# --- Azure DevOps Repos を使う場合のみ ----------------------
AZDO_ORG_URL=https://dev.azure.com/your-org
AZDO_PROJECT=your-project
AZDO_VARIABLE_GROUP_ID=0
AZDO_SERVICE_CONNECTION=your-service-connection

# --- その他 Git ホスティング（Key Vault に一元化）-----------
AZURE_KEYVAULT_NAME=your-keyvault

# ============================================================
# 秘匿区分
#   非秘匿: IMPLEMENTATION_MODE / GIT_PROVIDER / SECRET_BACKEND /
#           AZDO_ORG_URL / AZDO_PROJECT / AZDO_VARIABLE_GROUP_ID /
#           AZDO_SERVICE_CONNECTION / AZURE_KEYVAULT_NAME
#           → alm.config.json の non_secret_vars にも登録する
#   秘匿  : 上記以外すべて（GUID・エンドポイント・接続文字列・キー）
# ============================================================
