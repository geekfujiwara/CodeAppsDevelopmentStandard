# power-pages — 環境変数サンプル
# このファイルはプレースホルダーのみ。実値はリポジトリルートの .env に置く（.gitignore 済み）。
# 値は scripts/（deploy_site.py / setup_auth.py / setup_permissions.py 等）が参照する。

# === Power Platform 環境（必須）===
# 取得元: Power Platform 管理センター > 環境
DATAVERSE_URL=https://{org}.crm.dynamics.com/
TENANT_ID={your-tenant-id}
ENV_ID={your-environment-id}

# === ソリューション設定 ===
SOLUTION_NAME={YourSolutionName}
PUBLISHER_PREFIX={prefix}

# === PAC CLI 認証プロファイル ===
# 取得元: pac auth list（アクティブなプロファイル名）
PAC_AUTH_PROFILE={YourProfileName}

# === Power Pages サイト設定 ===
# サイト ID（取得元: GET https://api.powerplatform.com/powerpages/environments/{ENV_ID}/websites?api-version=2024-10-01 の value[].id）
PAGES_WEBSITE_ID={website-id}
# サブドメイン（PAGES_WEBSITE_ID 未設定時の再起動フォールバック）
PP_SUBDOMAIN={subdomain}
# .powerpages-site ディレクトリのパス（未設定時は規定の探索）
POWERPAGES_SITE_PATH=
PORTAL_DIR=
PORTAL_ROOT=

# === テーブル権限 / 認証セットアップ（オプション）===
# 公開対象テーブルの論理名
PORTAL_TABLE_LOGICAL={prefix}_incident
# Web ロール名（relink_table_permissions.py で再付与する対象・部分一致カンマ区切り）
RELINK_WEBROLE_NAMES=Authenticated
# Contact の Web API 有効化フィールド（カンマ区切り）
CONTACT_WEBAPI_FIELDS=

# === アクセススコープ（Self / Account）: setup_access_scope.py 用 ===
# Step 4 の AskUserQuestion 結果: self | account
ACCESS_SCOPE=self
# 管理者用 Code Apps 紐づけ画面を作成するか: true | false
# （Account アクセスでは紐づけ手段が必須。false にする場合はモデル駆動型アプリ運用を README に明記する）
ADMIN_LINK_APP=true
# Web ロール名（未設定時は Authenticated Users。専用ロールは contact への割り当てが別途必要）
ACCESS_SCOPE_WEBROLE_NAME=
# Self アクセス時の業務テーブル「論理名:contact との 1:N リレーションスキーマ名」カンマ区切り
# 例) SELF_CHILD_TABLES={prefix}_inquiry:contact_{prefix}_inquiries
SELF_CHILD_TABLES=
# Account アクセス時の業務テーブル「論理名:account との 1:N リレーションスキーマ名」カンマ区切り
# 例) ACCOUNT_CHILD_TABLES={prefix}_project:account_{prefix}_projects
ACCOUNT_CHILD_TABLES=
# 業務テーブルの削除を許可するか（既定 false）
ACCESS_SCOPE_ALLOW_DELETE=false
# Webapi/{table}/fields の値（既定は * 。許可リスト外の列を SELECT すると 403）
ACCOUNT_WEBAPI_FIELDS=*
ACCESS_SCOPE_CHILD_WEBAPI_FIELDS=*

# === 紐づけ依頼（setup_account_link_request.py / Power Automate フロー）===
# 依頼テーブルの論理名（既定: {prefix}_accountlinkrequest）
ACCOUNT_LINK_REQUEST_TABLE=
# 依頼テーブルと contact の 1:N リレーションスキーマ名
# 例) contact_{prefix}_accountlinkrequests
ACCOUNT_LINK_REQUEST_RELATIONSHIP=
# 依頼メールの宛先（管理者のメールアドレス／配布リスト）
ACCOUNT_LINK_ADMIN_RECIPIENT=admin@example.com

# === 報告者 Contact Lookup（setup_inquiry_reporter.py 用・オプション）===
# 既定が自動生成されるため、変更が必要な場合のみ設定する
REPORTER_LOOKUP_ATTR=

# === デプロイ制御（オプション）===
# DEPLOY_ENV: デプロイ先環境の識別子 / SKIP_REMOTE: リモート処理スキップ（true/空）
DEPLOY_ENV=
SKIP_REMOTE=
