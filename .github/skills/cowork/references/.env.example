# Tenant and Dataverse
TENANT_ID=
DATAVERSE_URL=https://<org>.crm.dynamics.com
PUBLISHER_PREFIX=new

# Entra OAuth client used by the Cowork connector
COWORK_OAUTH_CLIENT_ID=
COWORK_OAUTH_CLIENT_SECRET=

# Created by the Developer Portal OAuth registration API
COWORK_OAUTH_REGISTRATION_ID=
COWORK_PORTAL_REGION=amer

# Plugin manifest developer fields (templates/sales-crm-plugin)
COWORK_DEVELOPER_NAME=Contoso
COWORK_DEVELOPER_URL=https://www.example.com
COWORK_PRIVACY_URL=https://www.example.com/privacy
COWORK_TERMS_URL=https://www.example.com/terms

# templates/agm-qa-plugin（scaffold 時に --questions で聞く）
# Dataverse の組織 URL（末尾スラッシュなし。DATAVERSE_URL から作る）
DATAVERSE_ORIGIN=https://<org>.crm.dynamics.com
# プラグインの ID（版を上げても変えない。uuid5(NAMESPACE_URL, '<DATAVERSE_ORIGIN>/agm-qa-plugin')）
COWORK_PLUGIN_ID=
# ロール「AGM 想定問答作成者」を割り当てる人（任意）
COWORK_AUTHOR_UPN=
# Developer Portal への送り方（cli: Agents Toolkit クライアントで CLI から / browser: 統合ブラウザから。既定 cli）
COWORK_PORTAL_TRANSPORT=cli
# Cowork Studio（tools/cowork-studio）が使う Python（既定: PATH の python）
COWORK_STUDIO_PYTHON=
