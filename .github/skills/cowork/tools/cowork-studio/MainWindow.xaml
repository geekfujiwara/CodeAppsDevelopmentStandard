<Window x:Class="CoworkStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cowork Studio" Width="1600" Height="960" MinWidth="1120" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg0}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Border x:Name="RootBorder" Background="{StaticResource Bg0}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="38"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="26"/>
      </Grid.RowDefinitions>

      <!-- ===== タイトル バー ===== -->
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
          <Border Width="24" Height="24" CornerRadius="5">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B2A4A" Offset="0"/>
                <GradientStop Color="#123B66" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <Border BorderBrush="#4CA2F8" BorderThickness="1" CornerRadius="5">
              <TextBlock Text="Cs" Foreground="#7CC0FF" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Border>
          <TextBlock Text="Cowork Studio" Margin="9,0,14,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextBright}"/>
          <Button Style="{StaticResource IconButton}" Content="&#xE8B7;" ToolTip="ルート フォルダを開く…" Click="OnOpenRoot" WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button Style="{StaticResource IconButton}" Content="&#xEC50;" ToolTip="プラグインのフォルダをエクスプローラーで開く" Click="OnRevealPlugin" WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="読み込み直す" Click="OnReload" WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Border Width="1" Height="16" Background="{StaticResource Line}" Margin="8,0"/>
          <TextBlock x:Name="TitleProject" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
          <RadioButton x:Name="WsDesign" GroupName="ws" Style="{StaticResource WorkspaceTab}" Content="デザイン" Checked="OnWorkspaceChecked" ToolTip="Ctrl+1  manifest・スキル・アイコンを編集" WindowChrome.IsHitTestVisibleInChrome="True"/>
          <RadioButton x:Name="WsPipeline" GroupName="ws" Style="{StaticResource WorkspaceTab}" Content="パイプライン" Checked="OnWorkspaceChecked" ToolTip="Ctrl+2  診断・登録・インストール" WindowChrome.IsHitTestVisibleInChrome="True"/>
          <RadioButton x:Name="WsOutput" GroupName="ws" Style="{StaticResource WorkspaceTab}" Content="出力" Checked="OnWorkspaceChecked" ToolTip="Ctrl+3 / Ctrl+M  書き出しキュー" WindowChrome.IsHitTestVisibleInChrome="True"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
          <Border x:Name="EnvChip" CornerRadius="11" Background="#202A33" BorderBrush="#2E3E4E" BorderThickness="1" Padding="10,2" VerticalAlignment="Center" Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="EnvDot" Width="7" Height="7" Fill="{StaticResource TextFaint}" VerticalAlignment="Center"/>
              <TextBlock x:Name="EnvChipText" Text="環境なし" Margin="7,0,0,0" FontSize="11.5" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <Button AutomationProperties.Name="書き出し" Style="{StaticResource Primary}" Click="OnQuickExport" ToolTip="Ctrl+M  書き出しキューへ" Margin="0,0,10,0" Height="26" WindowChrome.IsHitTestVisibleInChrome="True">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xEDE1;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,7,0"/>
              <TextBlock Text="書き出し" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximize" WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="OnClose" WindowChrome.IsHitTestVisibleInChrome="True"/>
        </StackPanel>
      </Grid>

      <!-- ===== ワークスペース（4 つのパネル グループ） ===== -->
      <Grid Grid.Row="1" Margin="5,0,5,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="5*" MinWidth="340"/>
          <ColumnDefinition Width="5"/>
          <ColumnDefinition Width="7*" MinWidth="460"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="11*" MinHeight="220"/>
          <RowDefinition Height="5"/>
          <RowDefinition Height="9*" MinHeight="200"/>
        </Grid.RowDefinitions>

        <!-- 左上: インスペクター / ソース -->
        <TabControl x:Name="TopLeftTabs" Grid.Row="0" Grid.Column="0" Style="{StaticResource PanelTabs}">
          <TabItem x:Name="InspectorTab" Header="インスペクター">
            <ScrollViewer x:Name="InspectorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="InspectorHost" Margin="14,12,14,16"/>
            </ScrollViewer>
          </TabItem>
          <TabItem x:Name="SourceTab" Header="ソース">
            <DockPanel>
              <Border DockPanel.Dock="Top" Height="30" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="10,0,6,0">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74E;" ToolTip="保存 (Ctrl+S)" Click="OnSaveSource"/>
                  <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE7A7;" ToolTip="ディスクから読み直す" Click="OnRevertSource"/>
                  <Ellipse x:Name="SourceDirtyDot" DockPanel.Dock="Left" Width="7" Height="7" Fill="{StaticResource Warn}" Margin="0,0,8,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                  <TextBlock x:Name="SourceTitle" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource TextDim}" Text="ファイルを選んでください"/>
                </DockPanel>
              </Border>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="44"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="#1A1A1A" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                  <TextBlock x:Name="LineNumbers" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource TextFaint}" TextAlignment="Right" Padding="0,5,8,0" LineStackingStrategy="BlockLineHeight" LineHeight="17"/>
                </Border>
                <TextBox x:Name="SourceEditor" Grid.Column="1" FontFamily="{StaticResource MonoFont}" FontSize="12" AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Background="{StaticResource Panel}" BorderThickness="0" Padding="6,4"
                         TextChanged="OnSourceChanged" ScrollViewer.ScrollChanged="OnSourceScroll"/>
              </Grid>
            </DockPanel>
          </TabItem>
        </TabControl>

        <!-- 右上: プログラム（プレビュー） -->
        <TabControl x:Name="TopRightTabs" Grid.Row="0" Grid.Column="2" Style="{StaticResource PanelTabs}">
          <TabItem Header="プログラム">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
              </Grid.RowDefinitions>
              <ContentControl x:Name="ProgramHost" Focusable="False"/>
              <Border Grid.Row="1" Background="#1A1A1A" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,0">
                <DockPanel>
                  <TextBlock x:Name="ProgramMeta" DockPanel.Dock="Right" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource Accent}" VerticalAlignment="Center" FontSize="12"/>
                  <TextBlock x:Name="ProgramCaption" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
              </Border>
            </Grid>
          </TabItem>
        </TabControl>

        <!-- 左下: プロジェクト / コンソール / 出力キュー -->
        <TabControl x:Name="BottomLeftTabs" Grid.Row="2" Grid.Column="0" Style="{StaticResource PanelTabs}">
          <TabItem x:Name="ProjectTab" Header="プロジェクト">
            <DockPanel>
              <Border DockPanel.Dock="Top" Padding="10,8,10,4">
                <TextBlock Text="プラグイン" Foreground="{StaticResource TextFaint}" FontSize="11"/>
              </Border>
              <ListBox x:Name="PluginList" DockPanel.Dock="Top" MaxHeight="120" SelectionChanged="OnPluginSelected"/>
              <Border DockPanel.Dock="Top" Padding="10,10,10,4" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,6,0,0">
                <DockPanel>
                  <TextBlock x:Name="FileCount" DockPanel.Dock="Right" Foreground="{StaticResource TextFaint}" FontSize="11"/>
                  <TextBlock Text="ファイル" Foreground="{StaticResource TextFaint}" FontSize="11"/>
                </DockPanel>
              </Border>
              <ListBox x:Name="FileList" SelectionChanged="OnFileSelected"/>
            </DockPanel>
          </TabItem>
          <TabItem x:Name="ConsoleTab" Header="コンソール">
            <DockPanel>
              <Border DockPanel.Dock="Top" Height="32" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="8,3">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE894;" ToolTip="消去" Click="OnClearConsole"/>
                  <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="すべてコピー" Click="OnCopyConsole"/>
                  <Button DockPanel.Dock="Right" x:Name="CancelRun" Style="{StaticResource IconButton}" Content="&#xE71A;" ToolTip="実行中の処理を止める" Click="OnCancelRun" IsEnabled="False"/>
                  <TextBlock DockPanel.Dock="Left" Text="&#xE71C;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="2,0,8,0"/>
                  <TextBox x:Name="ConsoleFilter" Height="26" Padding="6,3" VerticalContentAlignment="Center" TextChanged="OnConsoleFilter" ToolTip="ログを絞り込む"/>
                </DockPanel>
              </Border>
              <ListBox x:Name="ConsoleList" FontFamily="{StaticResource MonoFont}" FontSize="11.5" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Padding" Value="8,1"/>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Time}" Foreground="{StaticResource TextFaint}" Width="64"/>
                      <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" FontWeight="{Binding Weight}"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </TabItem>
          <TabItem x:Name="QueueTab" Header="出力キュー">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <DockPanel Grid.Column="0">
                <Border DockPanel.Dock="Top" Padding="10,8,10,4">
                  <TextBlock Text="プリセット" Foreground="{StaticResource TextFaint}" FontSize="11"/>
                </Border>
                <ListBox x:Name="PresetList" SelectionChanged="OnPresetSelected"/>
              </DockPanel>
              <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                <DockPanel>
                  <Border DockPanel.Dock="Top" Padding="10,8" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" AutomationProperties.Name="キューに追加" Click="OnAddToQueue" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                          <TextBlock Text="キューに追加"/>
                        </StackPanel>
                      </Button>
                      <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8B7;" ToolTip="出力先を選ぶ" Click="OnBrowseOutput" Margin="4,0,0,0"/>
                      <TextBlock DockPanel.Dock="Left" Text="出力先" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                      <TextBox x:Name="OutputFolder" Height="28" Padding="6,3" VerticalContentAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="11.5"/>
                    </DockPanel>
                  </Border>
                  <Border DockPanel.Dock="Bottom" Padding="10,8" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                    <DockPanel>
                      <Button x:Name="StartQueue" AutomationProperties.Name="キューを開始" DockPanel.Dock="Right" Style="{StaticResource GoButton}" Click="OnStartQueue" ToolTip="Enter">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                          <TextBlock Text="キューを開始"/>
                        </StackPanel>
                      </Button>
                      <Button DockPanel.Dock="Right" Content="完了を消去" Click="OnClearQueue" Margin="0,0,8,0"/>
                      <TextBlock x:Name="QueueSummary" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                    </DockPanel>
                  </Border>
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="QueueList" Margin="0,4">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Margin="8,3" Padding="10,7" CornerRadius="3" Background="#242424" BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="60"/>
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{Binding StatusBrush}" VerticalAlignment="Center"/>
                              <StackPanel Grid.Column="1" Margin="4,0,8,0">
                                <TextBlock Text="{Binding Preset}" Foreground="{StaticResource TextBright}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Output}" Foreground="{StaticResource TextDim}" FontFamily="{StaticResource MonoFont}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Output}"/>
                              </StackPanel>
                              <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="11.5" Margin="0,0,0,4" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/>
                                <ProgressBar Value="{Binding Progress}" IsIndeterminate="{Binding IsRunning}" Foreground="{Binding StatusBrush}"/>
                              </StackPanel>
                              <TextBlock Grid.Column="3" Text="{Binding Elapsed}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextDim}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </Border>
            </Grid>
          </TabItem>
        </TabControl>

        <!-- 右下: タイムライン -->
        <TabControl x:Name="BottomRightTabs" Grid.Row="2" Grid.Column="2" Style="{StaticResource PanelTabs}">
          <TabItem x:Name="TimelineTab" Header="タイムライン">
            <DockPanel>
              <Border DockPanel.Dock="Top" Height="38" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="10,0">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button AutomationProperties.Name="選んだステップを実行" Click="OnRunSelected" ToolTip="Ctrl+Enter  選んだステップの主な操作" Margin="0,0,6,0">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="選んだステップを実行"/>
                      </StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="全体を確認" Style="{StaticResource Primary}" Click="OnRefreshAll" ToolTip="F5  診断・OAuth 登録・個人インストールの状態をまとめて確認">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="全体を確認"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                  <TextBlock x:Name="Timecode" DockPanel.Dock="Left" FontFamily="{StaticResource MonoFont}" FontSize="19" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Text="00:00"/>
                  <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock x:Name="SequenceName" Foreground="{StaticResource TextBright}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SequenceMeta" Foreground="{StaticResource TextFaint}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </DockPanel>
              </Border>
              <Grid x:Name="TimelineGrid" Margin="0,0,0,6" ClipToBounds="True"/>
            </DockPanel>
          </TabItem>
        </TabControl>

        <GridSplitter Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>
        <GridSplitter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>
      </Grid>

      <!-- ===== ステータス バー ===== -->
      <Border Grid.Row="2" Padding="12,0">
        <DockPanel>
          <TextBlock x:Name="StatusRoot" DockPanel.Dock="Right" Foreground="{StaticResource TextFaint}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520"/>
          <ProgressBar x:Name="BusyBar" DockPanel.Dock="Left" Width="90" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,10,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="StatusText" Foreground="{StaticResource TextDim}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
      </Border>
    </Grid>
  </Border>
</Window>
