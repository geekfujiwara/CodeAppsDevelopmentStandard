# admin スキルが使うパラメータ（実値は .env に置く）

# 対象環境の ID（Power Platform 管理センター > 環境 > 詳細）
ENV_ID=00000000-0000-0000-0000-000000000000

# Entra テナント ID（DLP ポリシーの URL パターン操作で使用）
TENANT_ID=00000000-0000-0000-0000-000000000000

# 対象環境の Dataverse URL（環境チェックの Dataverse 項目に使用。ENV_ID と同じ環境を指すこと）
DATAVERSE_URL=https://<org>.crm.dynamics.com

# 管理センター > 環境グループ > 環境ルーティングに表示される既存ルール名
ADMIN_ROUTING_RULE_NAME=<existing-routing-rule-name>
# 元グループと承認済み移行先の ID（環境 ID ではない）。移行先のゼロ GUID は None への割り当て解除
ADMIN_ROUTING_SOURCE_GROUP_ID=00000000-0000-0000-0000-000000000000
ADMIN_ROUTING_TARGET_GROUP_ID=00000000-0000-0000-0000-000000000000
# 削除が承認された空グループの ID と表示名。専用ポリシー整理も計画に含む
ADMIN_DELETE_GROUP_ID=00000000-0000-0000-0000-000000000000
ADMIN_DELETE_GROUP_NAME=<obsolete-group-name>
