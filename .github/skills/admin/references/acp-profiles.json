{
  "$comment": [
    "ACP（Advanced connector policies）の推奨許可セット定義。",
    "ACP は default-deny のため、ここに載らないコネクタはすべてブロックされる。",
    "allowPatterns はコネクタ ID（shared_xxx）に対する完全一致の正規表現。",
    "allowConnectors はカタログ未掲載時も候補に含める明示的なコネクタ ID。拒否規則と除外ソースは優先する。",
    "第一者判定は ID パターンと公開元の両方を検証する。第三者サービス・第三者公開元・不明公開元を除外する。",
    "カスタムコネクタは第一者限定では引き継がない。全許可グループでもカタログで確認した ID のみを列挙する。",
    "判定は取得した全カタログと検証済みの明示 ID に対して行う。既存許可は無条件に継承しない。"
  ],
  "legacyConnectors": [
    "shared_commondataservice", "shared_dynamicscrmonline", "shared_dynamicsnav2016",
    "shared_microsoftsearch", "shared_microsoftgraphsecurity", "shared_teamsvirtualevents",
    "shared_skypeforbiz", "shared_office365video", "shared_kaizala"
  ],
  "profiles": {
    "block-all": {
      "displayName": "全コネクタをブロック",
      "blockAll": true,
      "allowPatterns": []
    },
    "all-supported": {
      "displayName": "全カタログを許可（レガシー除外）",
      "allowPatterns": [".*"],
      "allowConnectors": ["shared_agentnode"]
    },
    "microsoft-first-party": {
      "displayName": "Microsoft 第一者サービスのみ許可",
      "description": "Microsoft が提供する自社サービス系コネクタだけを許可し、Microsoft が公開していても実体がサードパーティのサービス（Google Drive / Facebook / Mailchimp / YouTube / Workday / Zendesk など）と非推奨コネクタはブロックする。",
      "excludeSources": ["independentpublisher", "powerapps-user-defined"],
      "allowedPublishers": ["Microsoft", "Microsoft Corporation", "Microsoft Copilot Studio", "Microsoft Translator"],
      "allowConnectors": ["shared_agentnode"],
      "requiredCatalogConnectors": [
        "shared_commondataserviceforapps",
        "shared_a365copilotchatmcp", "shared_a365memcp",
