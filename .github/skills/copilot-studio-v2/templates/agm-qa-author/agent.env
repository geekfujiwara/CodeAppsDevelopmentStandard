# AGM Q&A Author（Copilot Studio v2）のデプロイ設定。
# deploy_agent.py / update_agent.py に --env-file agent.env で渡す。相対パスはこのフォルダ基準。
# 認証・環境（DATAVERSE_URL / TENANT_ID / SOLUTION_NAME）はプロジェクト直下の .env から読む。
AGENT_NAME=AGM Q&A Author
AGENT_SCHEMA=${PUBLISHER_PREFIX}_agmqaauthor
AGENT_MODEL_SERIES=${AGENT_MODEL_SERIES}
AGENT_INSTRUCTIONS_FILE=instructions.md
AGENT_PROMPTS_FILE=prompts.json
SKILL_DIR=skills
ICON_TEXT=Q
ICON_BG_COLOR=#1D4E89
ICON_ACCENT_COLOR=
APP_SHORT_DESCRIPTION=IR 資料を根拠に株主総会の想定問答とリハーサル台本を下書きし、Dataverse に登録する
APP_LONG_DESCRIPTION=株主総会 Q&A アシストと同じ Dataverse を使い、IR 抜粋と既存の想定問答を確認したうえで、新しい想定問答の下書きを作ります。回答の数値は根拠の IR 抜粋にあるものだけを使い、登録は利用者の確認後に「下書き」として行います。議長・株主・回答役員のリハーサル台本の作成と、既存の想定問答の点検も行います。
APP_DEVELOPER_NAME=${APP_DEVELOPER_NAME}
APP_WEBSITE_URL=${APP_WEBSITE_URL}
APP_PRIVACY_URL=${APP_PRIVACY_URL}
APP_TERMS_URL=${APP_TERMS_URL}
APP_TEAMS_SCOPES=personal
APP_M365_ENABLED=true
