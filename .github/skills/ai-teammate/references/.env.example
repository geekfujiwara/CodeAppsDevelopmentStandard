# ai-teammate — 環境変数サンプル

このファイルはプレースホルダーのみ。実値はテーマリポジトリのルートの `.env` に置く（`.gitignore` 済み）。
値は `scripts/*.py` が引数未指定時のデフォルトとして参照する。

```dotenv
# === 実装ルートと CI のルーティング（非秘匿）===
# poc  = ライト実装（CI/CD なし、共有エージェント）
# full = 本格実装（private リポジトリ + CI/CD + インスタンス化）
IMPLEMENTATION_MODE=poc
# github | azure-devops | other
GIT_PROVIDER=github
# github | azure-devops | keyvault | none（poc は none）
SECRET_BACKEND=none
# full のときの GitHub リポジトリ（private を既定にする）
GIT_REPOSITORY_OWNER=your-org
GIT_REPOSITORY_NAME=your-agent-repo
GIT_REPOSITORY_VISIBILITY=private

# === 人格・役割（scaffold_ai_teammate.py の decisions JSON にも書く。ここは既定値の控え）===
AGENT_ROLE=同僚エージェント
AGENT_PERSONALITY=誠実で頼れる態度で対応します

# === Dataverse / AI チームメイト評価Hub（必須。Code Apps 標準サンプルと共通）===
# 取得元: 環境の詳細ページの環境 URL
DATAVERSE_URL=https://<org>.crm.dynamics.com
# 取得元: 環境の詳細ページの環境 ID
ENV_ID=00000000-0000-0000-0000-000000000000
SOLUTION_NAME=YourAgentSolution
# テーブル論理名の接頭辞（英小文字始まり、英小文字+数字+_ のみ）。評価Hub のテーブル名にも使う
PUBLISHER_PREFIX=geek
# 評価Hub（Code App）の表示名。未設定なら "AI チームメイト評価Hub"（環境に 1 つを共用し、エージェントは表内で区別）
# チームメイトごとに別名を入れると Hub が分裂し、評価履歴が互いに見えなくなる
# EVALUATION_APP_DISPLAY_NAME=
# 以下 2 つは scripts/deploy_ai_teammate.py --execute が
# code-apps/scripts/setup_connection_reference.py --write-env で自動的に書き込む（手入力不要）
SOLUTION_ID=
CONNECTION_REFERENCE_LOGICAL_NAME=

# === Azure OpenAI（必須。B3 共有の頭脳）===
AZURE_OPENAI_ENDPOINT=https://your-aoai-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
# B15 の利用実績評価に使う小型モデル（省略時 gpt-4.1-mini）
EVALUATION_JUDGE_DEPLOYMENT=gpt-4.1-mini
# 評価Hub の「自動テスト」で NG だった応答から Issue を起票する先（owner/repo）。
# 未設定なら起票ボタンは出ず、Issue の URL を手入力で記録するだけになる。
# evaluation-app/.env の VITE_GITHUB_REPO に同じ値を入れる
# GITHUB_REPO=your-org/your-repo
# 社内 / 社外の判定に使うドメイン（カンマ区切り）
ORGANIZATION_INTERNAL_DOMAINS=your-org.onmicrosoft.com

# === 頭脳の実装方式（B3）===
# copilot-sdk（既定）= GitHub Copilot SDK ランタイム / agents-sdk = 自前 Chat Completions ループ
# 値を変えると AgentBrain.cs が丸ごと入れ替わる。scaffold 後の変更は書き直しになる
AGENT_RUNTIME=copilot-sdk

# === Copilot SDK ランタイム（AGENT_RUNTIME=copilot-sdk のときのみ）===
# App Service の Copilot__* / Agent__TurnTimeoutSeconds に対応する。秘匿値ではない
# 推論先は AZURE_OPENAI_ENDPOINT / AZURE_OPENAI_DEPLOYMENT をそのまま使う（BYOK）。
# 送信は App Service の UAMI で認証するため、API キーは持たない
# （課金帰属とデータ境界 → references/licensing-and-data-boundary.md）
# ランタイムの作業ディレクトリ。**アプリの配置先（/home/site/wwwroot）にしない**
# App Service では /home 配下だけが永続かつ書き込み可能
COPILOT_WORK_DIR=/home/data/copilot/work
# セッション状態の保存先
COPILOT_STATE_DIR=/home/data/copilot/state
# 1 ターンの上限秒。資料作成を含むなら 900 秒以上を見込む
AGENT_TURN_TIMEOUT_SECONDS=1200

# === Azure / Foundry プロジェクト（秘匿）===
# 取得元: az account show --query id / Foundry プロジェクトの概要ページ
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_RESOURCE_GROUP=rg-your-group
AZURE_AI_ACCOUNT=your-foundry-account
AZURE_AI_PROJECT=your-project
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# 取得元: Foundry プロジェクト概要ページの "Project endpoint"
FOUNDRY_PROJECT_ENDPOINT=https://your-account.services.ai.azure.com/api/projects/your-project

# === エージェント識別子（公開識別子・秘匿対象外）===
# kebab-case。フォルダ名 agents/<AGENT_NAME>/ と一致させる
AGENT_NAME=your-agent
# 取得元: scripts/create_blueprint.py --name <name> の blueprintName
BLUEPRINT_ID=your-agent
# 評価Hub の組織図でこのチームメイトをぶら下げる先。人間のオーナー直下なら VITE_ORG_OWNER_KEY と同じ値、
# 別のチームメイトの下に付けるならそのチームメイトの AGENT_NAME を入れる
AGENT_MANAGER_KEY=owner

# === 評価Hub（Code App）の表示設定 ===
# VITE_ で始まる値は deploy_ai_teammate.py が evaluation-app/.env へそのまま引き継ぐ
VITE_GITHUB_REPO=your-org/your-repo
# 組織図の最上位に置く人間のオーナー。VITE_ORG_OWNER_NAME が空なら人間の行は出ない
VITE_ORG_OWNER_KEY=owner
VITE_ORG_OWNER_NAME=Your Name
VITE_ORG_OWNER_ROLE=AI チームメイトのオーナー
VITE_ORG_OWNER_UPN=owner@example.com

# === Foundry のマネージド ID（秘匿）===
# 取得元: scripts/create_blueprint.py --name <name> --show
BLUEPRINT_PRINCIPAL_ID=00000000-0000-0000-0000-000000000000
BLUEPRINT_CLIENT_ID=00000000-0000-0000-0000-000000000000
# 取得元: エージェント作成後の agents.get / Foundry ポータルのエージェント詳細
# 自己ホスト方式では Foundry のインスタンス ID は存在しない。manifest の id / botId は
# ブループリントの appId（A365_AGENT_BLUEPRINT_ID と同じ値）を入れる
INSTANCE_IDENTITY_PRINCIPAL_ID=00000000-0000-0000-0000-000000000000
INSTANCE_IDENTITY_CLIENT_ID=00000000-0000-0000-0000-000000000000
AGENT_GUID=00000000-0000-0000-0000-000000000000

# === Agent 365（秘匿）===
# 取得元: a365 setup blueprint -n <name> --no-endpoint → a365.generated.config.json の agentBlueprintId
# 未設定の場合 build_teams_package.py は共有エージェント用パッケージにダウングレードする
A365_AGENT_BLUEPRINT_ID=00000000-0000-0000-0000-000000000000

# 取得元: M365 管理センターで作成したインスタンスの appId
# grant_agent_instance_consent.py の既定値。インスタンスを作り直すたびに更新する
A365_AGENT_INSTANCE_ID=00000000-0000-0000-0000-000000000000

# 取得元: M365 管理センターで作成されたエージェンティック ユーザーの objectId
# configure_agent_presence.py と App Service の Agentic__UserId に使用する
A365_AGENT_USER_ID=00000000-0000-0000-0000-000000000000

# === 受信トレイ監視（B6・任意）===
# App Service の Mailbox__Enabled / Mailbox__PollSeconds に対応する。秘匿値ではない
# Agent 365 はメールを push しないため、有効にすると自分の受信トレイをポーリングする
MAILBOX_ENABLED=false
MAILBOX_POLL_SECONDS=60

# === Web 検索（B10・任意）===
# App Service の WebSearch__Enabled に対応する。秘匿値ではない
# 既定は Grounding with Bing（Azure OpenAI Responses API の web_search ツール）。
# 追加リソースは不要で、App Service の UAMI をそのまま使う
WEB_SEARCH_ENABLED=false
# 検索を別デプロイで回したいときだけ。未設定なら LLM と同じデプロイを使う
# WEB_SEARCH_DEPLOYMENT=your-deployment

# === 画像生成（B17・任意）===
# scripts/provision_image_model.py --check で対象アカウントへの提供を確認してから有効化する
IMAGE_GENERATION_ENABLED=false
AZURE_OPENAI_RESOURCE_GROUP=rg-your-ai
AZURE_OPENAI_ACCOUNT=your-ai-account
# 取得元: scripts/provision_image_model.py --check。対象アカウントで提供される名前を指定する
IMAGE_GENERATION_MODEL=gpt-image-1.5
# deployment 名は任意。未指定時は IMAGE_GENERATION_MODEL と同じ名前を使う
IMAGE_GENERATION_DEPLOYMENT=gpt-image-1.5
# 対象アカウントで利用可能な SKU と capacity を指定する
IMAGE_GENERATION_SKU=GlobalStandard
IMAGE_GENERATION_CAPACITY=1
IMAGE_GENERATION_TIMEOUT_SECONDS=300

# === Web IQ MCP（任意・招待済みのテナントのみ）===
# 画像・動画検索が業務要件のときだけ併用する。未設定なら接続を試みない
# API キーは**秘匿値**。.env にのみ置き、App Service のアプリ設定へ注入する
# WEBIQ_ENDPOINT=https://<web-iq-mcp-endpoint>
# WEBIQ_SCOPE=https://<web-iq-resource>/.default
# WEBIQ_API_KEY=

# === 定期実行・定期配信（B11・任意）===
# App Service の Schedule__* に対応する。秘匿値ではない
# 頻度・時刻・配信先は会話で登録され、JSON ファイルに保存される
SCHEDULE_ENABLED=false
# 期限判定の間隔。実装側で 15〜900 秒に丸められる
SCHEDULE_TICK_SECONDS=60
# 停止中に過ぎた実行を、復帰後どこまで遡って流すか
SCHEDULE_CATCH_UP_MINUTES=30
# 保存先。未設定なら %HOME%/data/schedules.json（App Service の永続領域）
# SCHEDULE_STORE_PATH=

# === コード実行サンドボックス（B12・任意）===
# App Service の Sandbox__* に対応する
# 実体は Azure Container Apps の動的セッション（Microsoft.App/sessionPools）
SANDBOX_ENABLED=false
# プール名。未設定なら <AGENT_NAME>-sandbox
SANDBOX_POOL_NAME=your-agent-sandbox
# 未設定ならリソース グループのリージョン
SANDBOX_LOCATION=westus2
# 1〜600
SANDBOX_MAX_SESSIONS=10
# 300〜3600。最終利用からこの秒数でセッションは破棄される
SANDBOX_COOLDOWN_SECONDS=300
# 実行環境からの外部通信。false にすると pip install も失敗する
SANDBOX_EGRESS=true
# 取得元: scripts/provision_code_sandbox.py が ARM の poolManagementEndpoint を読み戻して書き戻す。
# 形が分かっても**手で組み立てない**（リージョン表記が環境で変わり 404 になる）
SANDBOX_ENDPOINT=

# === Agent Skills（既定で導入・任意）===
# scaffold / deploy が GitHub リリースから skills/ へ展開する。秘匿値ではない
# リリース資産を公開している owner/repo
AGENT_SKILLS_REPO=geekfujiwara/copilot-cowork-skills
# 固定したいリリース タグ。未設定なら latest（再現性が要るなら必ず固定する）
AGENT_SKILLS_TAG=

# === 経過連絡（B13・任意）===
# App Service の Agent__Progress__* に対応する。秘匿値ではない
# 待っている相手がいるチャットでだけ動く（ワーカー経由では使わない）
PROGRESS_ENABLED=true
# 最初の自動通知までの秒数
PROGRESS_FIRST_NOTE_SECONDS=25
# 2 回目以降の間隔
PROGRESS_INTERVAL_SECONDS=45
# 入力中インジケーターの再送間隔
PROGRESS_TYPING_SECONDS=5

# === メールへの HTML 返信（B6・任意）===
# App Service の Mail__Enabled に対応する。秘匿値ではない
# 受信トレイのスイープでだけ有効にする（Teams の会話ターンでは見せない）
# 委任スコープに Mail.Send が必要（grant_agent_graph_scopes.py）
MAIL_ENABLED=true

# === 成果物の共有と同意（B14・任意）===
# App Service の Documents__* に対応する。秘匿値ではない
# 委任スコープに Files.ReadWrite が必要
DOCUMENTS_ENABLED=false
# 成果物の保存先 OneDrive フォルダー。**生成側と共有側で必ず同じ値にする**
DOCUMENTS_FOLDER=your-agent-files
# 台帳 JSON の保存先。未指定なら %HOME%/data/documents.json（App Service の永続共有）
DOCUMENTS_LEDGER_PATH=

# === 利用実績の計測（B15）===
# App Service の Usage__* に対応する。秘匿値ではない
# **役割によらず入れる。記録していなかった期間はさかのぼれない**
USAGE_ENABLED=true
# 記録の保存先。未指定なら %HOME%/data/usage（App Service の永続共有）
USAGE_STORE_PATH=/home/data/usage
# レポートの表示通貨。Azure の請求は USD 建てなので USD のまま持つのが既定
USAGE_CURRENCY=USD
# 円の併記に使う固定レート（為替は毎月動くので、あくまで目安として併記する）
USAGE_JPY_RATE=150
# 全員分の利用実績を見られる管理者の UPN（カンマ区切り）。
# **空にしない**——空だと全員が全員分を見られる（個人別の利用量は個人情報）
USAGE_ADMINS=admin@contoso.com

# === 自己ホスト（Azure Bot Service + App Service）===
# すべて scripts/provision_selfhost.py --write .env が書き込む
# Bot 登録名は全 Azure テナントで一意。AGENT_NAME が取られている場合はここに実際の名前が入る
AZURE_BOT_NAME=your-agent
# Bot の msaAppId（= ユーザー割り当てマネージド ID の clientId）。appsettings.json の
# TokenValidation:Audiences に列挙する
AZURE_BOT_MSA_APP_ID=00000000-0000-0000-0000-000000000000
AGENT_WEBAPP_NAME=your-agent-agent
# a365 setup blueprint --endpoint-only --messaging-endpoint に渡す値
AGENT_MESSAGING_ENDPOINT=https://your-agent-agent.azurewebsites.net/api/messages

# === Teams アプリ manifest（公開メタデータ・秘匿対象外）===
# 再アップロードのたびに必ず上げる（同一バージョンは拒否される）
TEAMS_APP_VERSION=1.0.0
# 30 文字以内 / 100 文字以内
AGENT_DISPLAY_NAME=Your Agent
AGENT_FULL_NAME=Your Agent - team assistant
# Teams アイコンの元画像（ファイルパス）。
# 未設定なら assets/agent-icon.png を使う。正方形・背景透過の PNG（512x512 推奨）。
AGENT_ICON=assets/agent-icon.png
# 80 文字以内 / 4000 文字以内
AGENT_DESCRIPTION_SHORT=Short description shown in the Teams app catalog.
AGENT_DESCRIPTION_FULL=Full description of what this agent does for the user.
DEVELOPER_NAME=Your Organization
DEVELOPER_WEBSITE_URL=https://www.example.com
DEVELOPER_PRIVACY_URL=https://www.example.com/privacy
DEVELOPER_TERMS_URL=https://www.example.com/terms
# webApplicationInfo.resource。所有ドメインの api:// URI
TEAMS_APP_RESOURCE_URI=api://www.example.com

# === 任意 ===
# create_instance.py の manifest モードで使うテンプレート ID
# AGENT_TEMPLATE_ID=your-agent-template-id

# === Foundry Autopilot（references/foundry-autopilot.md・任意）===
# 自己ホストではなく Foundry hosted agent を Autopilot として発行する経路でだけ使う。
# scripts/publish_foundry_autopilot.py が読む。AZURE_* / FOUNDRY_PROJECT_ENDPOINT /
# AGENT_NAME / AGENT_DISPLAY_NAME / DEVELOPER_* / TEAMS_APP_VERSION は上の定義を共用する。
# コンテナー イメージ（az acr build で push したもの。Docker は不要）
# ACR_LOGIN_SERVER=youracr.azurecr.io
# AGENT_IMAGE_NAME=your-agent
# AGENT_IMAGE_TAG=latest
# エージェント コンテナーのサイズ
# AUTOPILOT_CONTAINER_CPU=2
# AUTOPILOT_CONTAINER_MEMORY=4Gi
# 既定は AZURE_OPENAI_DEPLOYMENT。Foundry プロジェクト側の配置名が違うときだけ設定する
# AUTOPILOT_MODEL_DEPLOYMENT=gpt-chat-latest
# Foundry Toolbox（Web 検索・コード インタープリター）の MCP エンドポイント
# FOUNDRY_TOOLBOX_ENDPOINT=https://your-account.services.ai.azure.com/api/projects/your-project/toolboxes/your-toolbox/mcp?api-version=v1
# 頭脳の実装。未設定だとコンテナー既定の 'responses' に戻るので、
# Copilot SDK を使っているなら再発行毎に必ず渡す
# TEAMMATE_BRAIN=copilot-sdk
# Activity が localTimezone を送ってこないときの既定タイムゾーン（IANA 名）。
# 未設定だと予定の時刻を UTC のまま答えてしまう
# DEFAULT_TIMEZONE=Asia/Tokyo
# 定期実行（B11）。true でツールと Invocations の受け口が有効になる（troubleshooting.md #88）
# SCHEDULE_ENABLED=true
# Logic App が起こす間隔（分）。実行時刻の誤差の上限になる。短いほど起動回数ぶんの課金が増える
# SCHEDULE_TICK_MINUTES=15
# SCHEDULE_LOGIC_APP_NAME=your-agent-schedule
# 自分のアドレス宛てのメールに応答するか（scaffold の質問 C）。true 以外は返信しない
# EMAIL_CHANNEL_ENABLED=false
# Teams の相手のメッセージにリアクションを付ける（届いたら 👀、内容に応じて 👍 ❤️ 🎉 など）。
# インスタンスに ChatMessage.Send の委任同意が要る。scaffold は既定で true（decisions の reactionsEnabled: false で無効）
# REACTIONS_ENABLED=true
# コンテナが使うエージェント ID の client id。publish_foundry_autopilot.py --execute が書き込む。
# setup_agent_dataverse_user.py が評価ハブのアプリケーション ユーザーをこの ID に作る（SOLUTION_NAME も要る）
# AGENT_IDENTITY_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Activity の宣言版。既定は受け口から自動判定（/activity/messages → 2.0.0、/api/messages → v1。troubleshooting.md #93）
# ACTIVITY_PROTOCOL_VERSION=2.0.0
# 次の 3 つは scaffold が AskUserQuestion の回答（emailEnabled / sharingPolicy / sensitiveData）から
# プロンプトへ書き込む。.env に置く必要はない（置いても decisions の回答が優先される）
# EMAIL_POLICY=
# SHARING_POLICY=
# SENSITIVE_DATA_POLICY=
# 既定の preview API バージョン。Learn の記載が変わったときだけ上書きする
# FOUNDRY_API_VERSION=2025-11-15-preview
# Tenant（テナント全体に発行）。検証中は管理者承認まで届かないので既定のままでよい
# AUTOPILOT_PUBLISH_SCOPE=Tenant
# Azure DevOps MCP のスコープを要求する場合だけ設定する。未設定ならスコープごと送らない
# （存在しない resource app を要求すると発行が dependency_error で落ちる。troubleshooting.md #72）
# AZURE_DEVOPS_ORGANIZATION=your-org

# === CI の Azure ログイン（シークレットストア専用 / .env では未使用）===
# GitHub Actions: フェデレーション資格情報を設定したアプリ登録
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# === Azure DevOps Repos を使う場合（SECRET_BACKEND=azure-devops）===
# 取得元: 組織の URL / プロジェクト名
# AZDO_ORG_URL=https://dev.azure.com/your-organization
# AZDO_PROJECT=your-project
# 取得元: az pipelines variable-group create --name ai-teammate --authorize true の id
# AZDO_VARIABLE_GROUP_ID=1
# ワークロード ID フェデレーションで作成した ARM サービス接続名
# AZDO_SERVICE_CONNECTION=your-azure-service-connection

# === その他 Git ホスティングを使う場合（SECRET_BACKEND=keyvault）===
# 取得元: az keyvault create で作成したボールト名
# AZURE_KEYVAULT_NAME=your-keyvault

# === hosting=foundry-autopilot のとき ===
# 公式クイックスタートの取得元。既定のまま使えるので通常は設定不要。
# 上流が壊れた・特定のコミットに固定したいときだけ変える。
# AUTOPILOT_QUICKSTART_REPO=microsoft-foundry/foundry-samples
# AUTOPILOT_QUICKSTART_REF=main
# AUTOPILOT_QUICKSTART_SUBPATH=samples/python/foundry-autopilot-agent
# 取得元: scaffold-plan.json（run_regression_tests.py が自動で読む）。手で上書きするときだけ設定する
# AGENT_HOSTING=foundry-autopilot
# 取得元: azd env get-values の TOOLBOX_ENDPOINT（Web 検索・コード実行の MCP）
# TOOLBOX_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>/toolboxes/<name>/mcp?api-version=v1
# スキルを評価ハブへ同期する間隔（分）。既定 30
# SKILLS_SYNC_MINUTES=30
# 画像生成（B17）。空にすると generate_image ツール自体が登録されない
# 発行前に scripts/provision_image_model.py --execute でこの名前のデプロイメントを作る
# （publish_foundry_autopilot.py --check が実在を検証し、無ければ発行を止める）
# エンドポイントはチームメイト本体と同じ Foundry アカウント直下を自動で使う
# 既定クォータは 1 リクエスト/分なので、連続生成は 429 になる（→ troubleshooting.md #78）
IMAGE_MODEL_DEPLOYMENT=gpt-image-2
# provision_image_model.py が作るモデル。IMAGE_MODEL_DEPLOYMENT と同じ名前にしておくと迷わない
IMAGE_GENERATION_MODEL=gpt-image-2

# === 回帰テストと評価 ===
# 取得元: 任意。Foundry の評価器が採点に使うモデル デプロイ。
# 本体と同じモデルに採点させるのは自己採点に近いので、別系統を指定するのが望ましい
# EVALUATION_JUDGE_DEPLOYMENT=gpt-4o-judge
# 振る舞いテストの合格ライン（0〜5）。既定 3.0
# REGRESSION_MIN_SCORE=3.0
# 1 ケースあたりの待ち時間（秒）。既定 600
# REGRESSION_CASE_TIMEOUT_SECONDS=600
```

## 秘匿区分

| 区分 | 変数 | 扱い |
|---|---|---|
| 秘匿 | `AZURE_*`（`AZURE_KEYVAULT_NAME` を除く） / `FOUNDRY_PROJECT_ENDPOINT` / `TOOLBOX_ENDPOINT` / `DATAVERSE_URL` / `*_PRINCIPAL_ID` / `*_CLIENT_ID` / `AGENT_GUID` / `A365_AGENT_BLUEPRINT_ID` / `A365_AGENT_USER_ID` / `AZURE_BOT_NAME` / `SANDBOX_ENDPOINT` / `SANDBOX_POOL_NAME` | `.env` と CI のシークレットストアのみ。テンプレートでは `${VAR}` |
| 非秘匿 | `AGENT_NAME` / `BLUEPRINT_ID` / `TEAMS_APP_VERSION` / `AGENT_DISPLAY_NAME` / `AGENT_FULL_NAME` / `AGENT_ICON` / `AGENT_DESCRIPTION_*` / `DEVELOPER_*` / `TEAMS_APP_RESOURCE_URI` / `MAILBOX_*` / `MAIL_ENABLED` / `SCHEDULE_*` / `PROGRESS_*` / `DOCUMENTS_ENABLED` / `DOCUMENTS_FOLDER` / `USAGE_ENABLED` / `USAGE_STORE_PATH` / `USAGE_CURRENCY` / `USAGE_JPY_RATE` / `USAGE_ADMINS` / `SANDBOX_ENABLED` / `SANDBOX_LOCATION` / `SANDBOX_MAX_SESSIONS` / `SANDBOX_COOLDOWN_SECONDS` / `SANDBOX_EGRESS` / `IMAGE_GENERATION_*` / `IMAGE_MODEL_DEPLOYMENT` / `AGENT_RUNTIME` / `AGENT_HOSTING` / `AUTOPILOT_QUICKSTART_*` / `SKILLS_SYNC_MINUTES` / `EVALUATION_JUDGE_DEPLOYMENT` / `REGRESSION_*` / `COPILOT_WORK_DIR` / `COPILOT_STATE_DIR` / `AGENT_TURN_TIMEOUT_SECONDS` | `alm.config.json` の `non_secret_vars`（および `sanitize.py` / `check_secrets.py` の `NON_SECRET_VARS` ）に登録し、置換対象から除外する |
| ルーティング設定 | `IMPLEMENTATION_MODE` / `GIT_PROVIDER` / `SECRET_BACKEND` / `AZDO_*` / `AZURE_KEYVAULT_NAME` | 「秘匿値をどこへ送るか」を決める値。`BACKEND_CONFIG_VARS` に登録し、置換も同期もしない |

非秘匿値を置換対象に含めると、`AGENT_NAME` のような短い文字列が
manifest の散文中で誤って `${AGENT_NAME}` に置き換わり、テンプレートが壊れる。
