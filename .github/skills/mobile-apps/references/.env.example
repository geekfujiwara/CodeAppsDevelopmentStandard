# Power Platform environment ID
ENVIRONMENT_ID=00000000-0000-0000-0000-000000000000

# Display name passed to `power-apps init -t MobileApp`
MOBILE_APP_DISPLAY_NAME=My Mobile App

# Tenant ID written to auth.config.json
TENANT_ID=00000000-0000-0000-0000-000000000000

# Application (client) ID created by Power Apps Wrap. This is not a secret.
MOBILE_APP_CLIENT_ID=00000000-0000-0000-0000-000000000000

# App ID generated by Power Apps and used by the Wrap URL after push
APP_ID=00000000-0000-0000-0000-000000000000