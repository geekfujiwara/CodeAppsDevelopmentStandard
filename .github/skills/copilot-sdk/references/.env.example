# copilot-sdk — 環境変数サンプル
# このファイルはプレースホルダーのみ。実値はリポジトリルートの .env に置く（.gitignore 済み）。
# 値は scripts/*.py が引数未指定時のデフォルトとして参照する。

# === エージェントの基本情報 ===
# kebab-case のエージェント名（リポジトリ名 / プロジェクト名の軸になる）
COPILOT_AGENT_NAME=<agent-name>

# エージェントの作業領域のルート（★ソース リポジトリの外を指定する）
# ランタイムの組み込みファイル操作ツールがここに書き込む
COPILOT_WORKSPACE_ROOT=<path-to-agent-workspaces>

# ランタイムのセッション状態の保存先（既定の ~/.copilot を共有しないために明示する）
# 未指定時は ${COPILOT_WORKSPACE_ROOT}/${COPILOT_AGENT_NAME}/.copilot
COPILOT_BASE_DIR=

# === モデル経路（byok | github）===
# byok   : 自社の Foundry / Azure OpenAI を直接呼ぶ（テナント内で完結・推奨）
# github : GitHub Copilot 経由（Copilot シート + AI クレジット課金）
COPILOT_ROUTE=byok

# 使用するモデル（BYOK ではデプロイ名の指定が必須）
COPILOT_MODEL=<model-deployment-name>

# === 経路 B: BYOK（Microsoft Foundry / Azure OpenAI）===
# 取得元: Azure ポータル > 対象リソース > エンドポイント
# ★ リソース URL のみを入れる（パスは付けない）。コード側で /openai/v1/ を付与する
FOUNDRY_RESOURCE_URL=https://<resource-name>.openai.azure.com

# Managed Identity を使う場合のトークン取得元（キーレス運用。キーは使わない）
# App Service / Container Apps ではこの 2 つを設定する
AZURE_TOKEN_CREDENTIALS=ManagedIdentityCredential
# ユーザー割り当てマネージド ID を使う場合のみ設定（取得元: Azure ポータル > マネージド ID > クライアント ID）
AZURE_CLIENT_ID=

# === 経路 A: GitHub Copilot 経由 ===
# 取得元: GitHub App のインストール トークン、または PAT
# ★ SDK の GitHubToken オプションではなく、この環境変数として渡す（→ troubleshooting）
COPILOT_GITHUB_TOKEN=

# === 前提チェックの閾値 ===
# 開発に必要な .NET SDK のメジャー バージョン
DOTNET_SDK_MAJOR=10
