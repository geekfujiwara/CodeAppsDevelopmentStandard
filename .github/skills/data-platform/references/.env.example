# data-platform — 環境変数サンプル
# 実値はリポジトリルートの .env に置く（.gitignore 済み）。共通の TENANT_ID 等は standard/references/.env.example を参照。

# === 共通（必須）===
# 取得元: Azure portal > サブスクリプション > 概要
AZURE_SUBSCRIPTION_ID={your-subscription-id}
# 例: japaneast。Fabric / Databricks / Foundry を同じリージョンに置くとデータ越境を避けられる
DP_LOCATION=japaneast
# 英字で始まる短い接頭辞。リソース名はここから機械的に導出する（下の個別指定が優先）
DP_NAME_PREFIX=example-data
# Foundry の Search ロールを付与する利用者 objectId。未設定ならサインイン中の利用者を使う
DP_OPERATOR_OBJECT_ID=

# === Microsoft Fabric ===
# capacity 管理者の UPN（取得元: Microsoft Entra 管理センター > ユーザー）
FABRIC_CAPACITY_ADMIN=admin@example.com
FABRIC_CAPACITY_SKU=F2
# 任意の個別指定（未設定なら DP_NAME_PREFIX から導出）
FABRIC_RESOURCE_GROUP=
FABRIC_CAPACITY_NAME=
FABRIC_WORKSPACE_NAME=
FABRIC_LAKEHOUSE_NAME=
FABRIC_ONTOLOGY_NAME=
# deploy_platform.py apply の出力から転記する
FABRIC_WORKSPACE_ID={fabric-workspace-id}
FABRIC_LAKEHOUSE_ID={fabric-lakehouse-id}
FABRIC_ONTOLOGY_ID={fabric-ontology-id}

# === Azure Databricks ===
DATABRICKS_RESOURCE_GROUP=
DATABRICKS_WORKSPACE_NAME=
# Databricks が作成する。事前作成しないこと
DATABRICKS_MANAGED_RESOURCE_GROUP=
DATABRICKS_WAREHOUSE_NAME=
DATABRICKS_WAREHOUSE_SIZE=2X-Small
# deploy_platform.py apply の出力から転記する（https:// は付けない）
DATABRICKS_HOST=adb-0000000000000000.0.azuredatabricks.net
DATABRICKS_WAREHOUSE_ID={warehouse-id}
# Unity Catalog の catalog。新規 workspace では workspace 名の catalog が既定で作られる
DATABRICKS_CATALOG={catalog-name}
# configure_semantics.py apply の出力から転記する
DATABRICKS_GENIE_SPACE_ID={genie-space-id}

# === Foundry IQ（AIServices + Azure AI Search）===
FOUNDRY_RESOURCE_GROUP=
FOUNDRY_ACCOUNT_NAME=
FOUNDRY_PROJECT_NAME=
SEARCH_SERVICE_NAME=
FOUNDRY_CHAT_MODEL=gpt-4.1-mini
FOUNDRY_CHAT_MODEL_VERSION=2025-04-14
FOUNDRY_EMBEDDING_MODEL=text-embedding-3-small
# リージョンで提供される SKU（Standard / GlobalStandard）
FOUNDRY_DEPLOYMENT_SKU=Standard
